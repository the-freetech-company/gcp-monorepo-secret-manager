{
  "version": 2,
  "environments": {
    "staging": {
      "provider": "local",
      "storePath": ".msm/store"
    },
    "production": {
      "provider": "gcp",
      "projectId": "your-production-project-id",
      "credentials": {
        "path": "gcloud/production/service-account.json"
      }
    }
  },
  "services": [
    {
      "name": "frontend",
      "envPath": ".environments/.frontend.{env}.env",
      "targetPath": "web/app/.env",
      "secrets": [
        {
          "kind": "env-file",
          "sourcePath": ".environments/.frontend.{env}.env",
          "targetPath": "web/app/.env",
          "remoteName": "frontend-env-file"
        }
      ]
    },
    {
      "name": "api",
      "envPath": ".environments/.api.{env}.env",
      "targetPath": "services/api/.env",
      "secrets": [
        {
          "kind": "env-file",
          "sourcePath": ".environments/.api.{env}.env",
          "targetPath": "services/api/.env",
          "remoteName": "api-env-file"
        },
        {
          "kind": "ssh-keypair",
          "remoteName": "api-deploy-ssh",
          "source": {
            "private": ".environments/api.{env}.id_ed25519",
            "public": ".environments/api.{env}.id_ed25519.pub"
          },
          "target": {
            "private": "services/api/.ssh/deploy",
            "public": "services/api/.ssh/deploy.pub"
          }
        }
      ]
    }
  ],
  "deletePolicy": {
    "maxVersions": 10,
    "maxAgeDays": 30,
    "enabled": true
  }
}
